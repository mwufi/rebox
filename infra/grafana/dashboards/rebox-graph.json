      "title": "Review queue size",
      "description": "Open review items (ambiguous matches, possible duplicates) over time.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rebox-metrics"
      },
      "gridPos": {
        "x": 12,
