    {
      "type": "table",
      "title": "Connector last-run age",
      "description": "Hours since each connector last ran, next to its schedule interval.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rebox-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rebox-metrics"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "-- Hours since each connector's last run (connector_state); scheduled interval for reference.\nselect source as \"connector\",\n       round(extract(epoch from now() - last_run_at)::numeric / 3600, 2) as \"hours since last run\",\n       round(interval_s / 3600.0, 2) as \"interval (h)\",\n       last_status as \"last status\",\n       last_run_at as \"last run\"\nfrom connector_state\norder by last_run_at nulls first"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
