            "uid": "rebox-metrics"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- Open review items over time: opened before t and not resolved by t (hourly samples).\nselect g as \"time\",\n       (select count(*) from review_item r\n         where r.created_at <= g and (r.resolved_at is null or r.resolved_at > g)) as \"open review items\"\nfrom generate_series(date_trunc('hour', $__timeFrom()::timestamptz), $__timeTo()::timestamptz, interval '1 hour') g\norder by 1"
        }
