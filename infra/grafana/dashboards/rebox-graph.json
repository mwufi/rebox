            "type": "grafana-postgresql-datasource",
            "uid": "rebox-metrics"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- Claims written per hour by worker (inserts + updates in the change feed).\nselect $__timeGroupAlias(at, '1h'), coalesce(worker_id, 'unattributed') as metric, count(*) as value\nfrom change\nwhere op in ('insert', 'update') and $__timeFilter(at)\ngroup by 1, 2 order by 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 60,
            "showPoints": "auto",
            "pointSize": 6,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0,
            "spanNulls": false,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
