    {
      "type": "timeseries",
      "title": "Entities over time by kind",
      "description": "Cumulative entities, counted at the first claim about each subject in the change feed; kind from the id prefix.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rebox-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rebox-metrics"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "-- Entities over time by kind: cumulative count of subjects by their first claim insert\n-- (kind from the id prefix rbx:<kind>:...). Public layers only.\nwith firsts as (\n  select subject, min(at) as at\n  from change\n  where op = 'insert' and subject is not null and layer_id like 'public/%'\n  group by subject\n), daily as (\n  select date_trunc('hour', at) as t, split_part(subject, ':', 2) as kind, count(*) as n\n  from firsts group by 1, 2\n), cum as (\n  select t, kind, sum(n) over (partition by kind order by t) as total from daily\n)\nselect t as \"time\", kind as metric, total::bigint as value\nfrom cum where t <= $__timeTo()\norder by 1, 2"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto",
            "pointSize": 6,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0,
            "barAlignment": 0,
            "spanNulls": false,
            "gradientMode": "none"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Claims per hour by worker",
      "description": "Claim inserts and updates per hour, by the worker that wrote them.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rebox-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
