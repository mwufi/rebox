# Owner URL: migrations only
MIGRATE_DATABASE_URL=postgres://postgres:dev@localhost:54329/rebox
# App role URL: what api and worker use (RLS applies)
DATABASE_URL=postgres://rebox_app:rebox_app@localhost:54329/rebox
# Password for role rebox_app (set by the migrate step)
APP_DB_PASSWORD=rebox_app
PORT=3000
API_URL=http://localhost:3000
INGEST_TOKEN=dev-ingest-token
ADMIN_TOKEN=dev-admin-token
RAW_STORE=file://./.data/raw
REBOX_ENV=dev
USER_AGENT=rebox-bot/0.1 (+https://github.com/rebox)
# Optional: enable live connectors (they stay disabled while empty)
GITHUB_TOKEN=
X_BEARER_TOKEN=
EXA_API_KEY=
# Optional: AI parsing (worker) and generated wikis (api)
ANTHROPIC_API_KEY=
PARSER_MODEL=claude-haiku-5-5
WIKI_MODEL=claude-haiku-5-5
# true lets anonymous viewers generate wikis
WIKI_PUBLIC=false
# Per-run budgets for paid APIs
X_MAX_USER_READS_PER_RUN=2000
X_MAX_POST_READS_PER_RUN=1000
EXA_MAX_REQUESTS_PER_RUN=100
PARSER_MAX_CALLS_PER_RUN=2000
# Password for the read-only Grafana role rebox_metrics (set by the migrate step)
METRICS_DB_PASSWORD=rebox_metrics
# Grafana admin login (anonymous viewers are read-only); host port for Grafana
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_HOST_PORT=3001
# Seconds between scheduler runs in the compose stack
SCHEDULE_INTERVAL_S=900
